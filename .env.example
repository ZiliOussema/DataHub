# Copier en .env.dev, .env.preprod ou .env.prod et adapter les valeurs.
ENV_FILE=.env.dev
DATAHUB_ENV=dev
DATAHUB_MONGO_URI=mongodb://mongo:27017
DATAHUB_MONGO_DB=datahub_dev
DATAHUB_MONGO_TIMEOUT_MS=5000
FRONTEND_TARGET=dev
FRONTEND_PORT=5173
FRONTEND_CONTAINER_PORT=5173
VITE_API_PROXY=http://backend:8000
